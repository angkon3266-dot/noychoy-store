APP_NAME="Meridian Éclat"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# 'daily', not 'single': a single file never rotates, which is how production's
# laravel.log reached 216 MB. LOG_DAILY_DAYS controls how many are kept (14).
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Floored at 'info' when APP_ENV=production; set LOG_DEBUG=true to override
# while chasing something. See config/logging.php.
LOG_LEVEL=debug

# ── Security (see config/security.php) ────────────────────────────────────────
# All optional — production defaults are already correct without them.
# FORCE_HTTPS=true            # defaults to true when APP_ENV=production
# FORCE_HTTPS_EXCEPT=up       # comma-separated paths left on their own scheme
# CSP_REPORT_ONLY=true        # log violations instead of blocking, to trial a change
# CSP_ENABLED=false           # drop the policy entirely
# CSP_EXTRA_HOSTS="https://static.tawk.to"   # extra script/connect/frame/img hosts

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# Sessions on Redis: set BOTH of the next two lines together, never one alone.
# SESSION_CONNECTION names a *Redis* connection under the `redis` driver but a
# *database* connection under `database`, so a leftover value would otherwise
# 500 every request after a rollback. config/session.php now only reads it when
# the driver is `redis`, but keep them paired anyway so the intent is readable.
#   SESSION_DRIVER=redis
#   SESSION_CONNECTION=session      # db 2 — see REDIS_SESSION_DB below
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# One logical database each, so no cache command can reach the sessions:
#   db 0 default · db 1 cache (cache:clear FLUSHDBs this)
#   db 2 sessions (nothing routine touches it)
# REDIS_CACHE_DB=1
# REDIS_SESSION_DB=2

# Email via Microsoft 365 SMTP. Use the mailbox's own password (or an app
# password if MFA is on) and make sure SMTP AUTH is enabled for the mailbox.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=support@meridianeclat.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="support@meridianeclat.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ──────────────────────────────────────────────────────────────────────────
# Store settings
# NOTE: Steadfast / KhudeBarta / Meta credentials can also be entered in
# Admin → Integrations (stored in the database). Values here are only the
# fallback if the admin fields are left blank.
# ──────────────────────────────────────────────────────────────────────────

# Storefront
STORE_CURRENCY=BDT
STORE_CURRENCY_SYMBOL="৳"
STORE_EMAIL=hello@meridianeclat.shop
STORE_PHONE=
FREE_SHIPPING_THRESHOLD=3000
SHIPPING_INSIDE_DHAKA=60
SHIPPING_OUTSIDE_DHAKA=120

# KhudeBarta SMS  (host:port only — do NOT add /sendtext; whitelist server IP)
SMS_ENABLED=false
KHUDEBARTA_BASE_URL=
KHUDEBARTA_API_KEY=
KHUDEBARTA_SECRET_KEY=
KHUDEBARTA_CALLER_ID=

# Steadfast Courier
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# Meta Pixel / Conversions API
META_PIXEL_ID=
META_CAPI_ENABLED=false
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# Google OAuth ("Continue with Google" for customers)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

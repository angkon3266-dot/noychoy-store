<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Never let the LiteSpeed page cache answer an Inertia (JSON) request with
    # cached HTML for the same URL — the React storefront would fail to parse
    # it. Dynamic pages carry no-cache headers anyway; this is the backstop.
    RewriteCond %{HTTP:X-Inertia} .
    RewriteRule .* - [E=cache-control:no-cache]

    # Never serve editor/backup leftovers. `.bak` is not a PHP extension, so a
    # stray public/test.php.bak or public/.htaccess.bak would be handed over as
    # plain text rather than executed — source and server config disclosure. The
    # real fix is not leaving them in the webroot; this makes sure the next one
    # can't be read either. Kept as a RewriteRule rather than <FilesMatch> +
    # Require so it relies only on mod_rewrite, which this file already needs.
    RewriteRule "(?i)\.(bak|backup|old|orig|save|swp|swo|tmp|dist)$|~$" - [F,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ── Static asset caching ──────────────────────────────────────────────────────
# Vite build assets are content-hashed, so they can be cached forever.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|ico|avif)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    # Hashed build assets never change at the same URL → immutable. The hash
    # alphabet includes '-', so it has to be part of the character class or
    # files like inertia-D7SRa7FU.js fall back to the one-year rule above.
    <FilesMatch "-[A-Za-z0-9_-]{8,}\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Uploaded brand fonts land in storage/fonts WITHOUT a file extension, so
    # none of the extension rules above match them and both the browser and
    # Cloudflare re-fetch ~290KB of render-blocking font on every visit.
    SetEnvIf Request_URI "^/storage/fonts/" IS_BRAND_FONT=1
    Header set Cache-Control "public, max-age=31536000, immutable" env=IS_BRAND_FONT
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# Compress text responses (LiteSpeed/Apache).
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
